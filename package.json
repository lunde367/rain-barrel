{
  "name": "rain-barrel",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "A cozy water-routing puzzle game.",
  "scripts": {
    "dev": "npx --yes serve web -l 5173",
    "fonts": "node scripts/fetch-fonts.mjs",
    "add:ios": "npx cap add ios",
    "add:android": "npx cap add android",
    "sync": "npx cap sync",
    "ios": "npx cap sync ios && npx cap open ios",
    "android": "npx cap sync android && npx cap open android",
    "icons": "node tools/icons/render.cjs",
    "assets": "npx @capacitor/assets generate --iconBackgroundColor \"#a6cf8a\" --splashBackgroundColor \"#edf2e3\" --splashBackgroundColorDark \"#182016\"",
    "app:setup": "node scripts/app-setup.mjs",
    "app:prepare": "npm run fonts && npm run assets && npm run app:setup && npx cap sync",
    "levels": "node tools/check-levels.mjs",
    "generate": "node tools/levelgen/generate.mjs",
    "rate": "node tools/levelgen/rate-levels.mjs",
    "test": "node tools/check-levels.mjs && node tools/test/first-play.mjs",
    "store": "node tools/store/make.cjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "^7.0.3",
    "@capacitor-community/in-app-review": "^7.0.1",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/preferences": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/assets": "^3.0.5"
  }
}
